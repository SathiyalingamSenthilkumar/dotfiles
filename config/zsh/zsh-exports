#!/bin/sh
HISTFILE=$ZDOTDIR/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000

# man page
export MANPAGER='nvim +Man!' # Man page in nvim
export MANWIDTH=999

# global enviroment variables
export EDITOR="nvim"
export TERMINAL="kitty"

# For yEd to work properly with Sway
export _JAVA_AWT_WM_NONREPARENTING=1

# path
typeset -gU path PATH # Drop duplicate entries
PATH="$HOME/.local/bin:${PATH}"
PATH="/opt/nvim-linux-x86_64/bin:${PATH}"

PATH="${PATH}:/opt/SEGGER/JLink"
PATH="${PATH}:$HOME/installation/manual/nrfutil"
PATH="${PATH}:$HOME/installation/STM/bin"
PATH="${PATH}:$HOME/installation/manual/yEd"

export PATH
